# Caddy routes — IP-only UAT host (no DNS, no TLS yet).
# When the hostname exists, replace ":80" with "https://<hostname>" and Caddy
# will issue the certificate itself.

:80 {
    encode zstd gzip

    @graphql path /graphql /graphql/*
    handle @graphql {
        reverse_proxy api:4000
    }

    @chat path /chat /chat/*
    handle @chat {
        uri strip_prefix /chat
        reverse_proxy librechat:3080
    }

    handle {
        reverse_proxy web:3000
    }
}

:4000 {
    encode zstd gzip
    reverse_proxy api:4000
}

:3080 {
    encode zstd gzip
    reverse_proxy librechat:3080
}
