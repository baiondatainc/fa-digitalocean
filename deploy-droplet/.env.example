# Copy to .env and fill in. The install.sh in this bundle generates
# strong random values and writes a ready-to-use .env for you.

# Neo4j admin password (choose anything, >= 8 chars — Neo4j enforces this)
NEO4J_PASSWORD=REPLACE_ME

# LibreChat crypto — generate with openssl
#   openssl rand -hex 32   (64 chars) for JWT_SECRET, JWT_REFRESH_SECRET, CREDS_KEY, MEILI_MASTER_KEY
#   openssl rand -hex 16   (32 chars) for CREDS_IV
JWT_SECRET=REPLACE_ME
JWT_REFRESH_SECRET=REPLACE_ME
CREDS_KEY=REPLACE_ME
CREDS_IV=REPLACE_ME
MEILI_MASTER_KEY=REPLACE_ME

# Optional — agent LLM provider (defaults to ollama with qwen3:4b)
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:4b-instruct-2507-q4_K_M
OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# UX
ALLOW_REGISTRATION=true
ALLOW_EMAIL_LOGIN=true
LOG_LEVEL=INFO
