# Copy to .env and fill in. `bash install-full.sh` does this for you and
# rotates every `CHANGE_ME_*` placeholder into a fresh random hex secret.
#
# The values below are the DEV defaults mirrored from
#   future-advisor/.env.example
#   future-advisor-forecast-agent/.env.example
#   synthea-neo4j/.env.example
#   dockers/.env.example
#   LibreChat/.env.example
# They are safe to interpolate for `docker compose config` but MUST be
# rotated before any public deployment.

# ─── DO container registry ─────────────────────────────────────────────
# Override only if you push to a different registry than the default.
REGISTRY=registry.digitalocean.com/future-advisor

# Pull tag for every FA image at once. Override per-service below if needed.
IMAGE_TAG=latest

# Per-service overrides (uncomment to pin). Fall back to IMAGE_TAG otherwise.
# WEB_TAG=
# API_TAG=
# FORECAST_PY_TAG=
# FORECAST_AGENT_TAG=
# INGEST_TAG=
# LIVE_AGENT_TAG=
# SYNTHEA_TAG=
# LIBRECHAT_TAG=

HOST=localhost
PORT=3080


MONGO_URI=mongodb://localhost:27017/LibreChat
MEILI_HOST=http://localhost:7700

#The maximum number of connections in the connection pool. */
MONGO_MAX_POOL_SIZE=
#The minimum number of connections in the connection pool. */
MONGO_MIN_POOL_SIZE=
#The maximum number of connections that may be in the process of being established concurrently by the connection pool. */
MONGO_MAX_CONNECTING=
#The maximum number of milliseconds that a connection can remain idle in the pool before being removed and closed. */
MONGO_MAX_IDLE_TIME_MS=
#The maximum time in milliseconds that a thread can wait for a connection to become available. */
MONGO_WAIT_QUEUE_TIMEOUT_MS=
# Set to false to disable automatic index creation for all models associated with this connection. */
MONGO_AUTO_INDEX=
# Set to `false` to disable Mongoose automatically calling `createCollection()` on every model created on this connection. */
MONGO_AUTO_CREATE=

# Neo4j (knowledge graph: KPI -> source -> document -> signal -> D33 objective)
NEO4J_URI=bolt://192.168.0.165:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j_dev_password
NEO4J_DATABASE=neo4j

# MinIO (object store for PDFs, CSVs, model artefacts)
MINIO_ENDPOINT=192.168.0.165
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=fa_minio
MINIO_SECRET_KEY=fa_minio_dev_password
MINIO_BUCKET_RAW=raw-documents
MINIO_BUCKET_PARSED=parsed-tables
MINIO_BUCKET_MODELS=model-artefacts


DOMAIN_CLIENT=http://localhost:3080
DOMAIN_SERVER=http://localhost:3080


# ---- Copy to .env (root) and dockers/.env. Never commit real secrets. ----

# Postgres / TimescaleDB
POSTGRES_USER=fa
POSTGRES_PASSWORD=fa_dev_password
POSTGRES_DB=future_advisor
POSTGRES_PORT=35432
DATABASE_URL=postgresql://fa:fa_dev_password@192.168.0.165:35432/future_advisor

# Neo4j (knowledge graph: KPI -> source -> document -> signal -> D33 objective)
NEO4J_URI=bolt://192.168.0.165:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j_dev_password
NEO4J_DATABASE=neo4j

# MinIO (object store for PDFs, CSVs, model artefacts)
MINIO_ENDPOINT=192.168.0.165
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=fa_minio
MINIO_SECRET_KEY=fa_minio_dev_password
MINIO_BUCKET_RAW=raw-documents
MINIO_BUCKET_PARSED=parsed-tables
MINIO_BUCKET_MODELS=model-artefacts

# NestJS API
API_PORT=4000
API_CORS_ORIGIN=http://192.168.0.165:3000,http://192.168.0.165:3000,http://localhost:3000,http://localhost:3000
JWT_SECRET=change-me-dev-only
JWT_EXPIRES_IN=8h

# Python forecast / extraction service
FORECAST_SERVICE_URL=http://host.docker.internal:8000
FORECAST_SERVICE_TOKEN=dev-shared-token

# Next.js web
NEXT_PUBLIC_GRAPHQL_URL=http://192.168.0.165:4000/graphql
NEXT_PUBLIC_APP_NAME=Future Advisor Alpha

# External data keys (ETL / forecast service only — never shipped to the browser)
EIA_API_KEY=iqUHyZr19q5h0l3oEbxi9x8xWGSjXQZvLin76mrt
FRED_API_KEY=ad8f63ee9d6a4940c9a1a140aa8afa8e
ALPHAVANTAGE_API_KEY=
DUBAI_PULSE_CLIENT_ID=
DUBAI_PULSE_CLIENT_SECRET=

# LLM (must be an in-country endpoint for the DoF implementation phase; see docs/architecture.md)
LLM_PROVIDER=anthropic
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
NEXT_PUBLIC_ASK_ALPHA_URL=http://localhost:3081

# ─── Public URL (used by API for CORS + Caddy for TLS) ─────────────────
# Set to an IP (http://x.x.x.x) for self-signed/tunnel, or a domain for
# automatic HTTPS via Caddy. Default is harmless for local bring-up.
PUBLIC_ORIGIN=http://localhost

# ─── FA API secrets ────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_JWT_SECRET
FORECAST_SERVICE_TOKEN=CHANGE_ME_FORECAST_SERVICE_TOKEN
AGENT_API_TOKEN=CHANGE_ME_AGENT_API_TOKEN

# ─── External data API keys (ingest-worker / forecast-py) ──────────────
# Blank is safe — the ingest worker simply skips any source whose key is
# missing. Fill in to enable fetchers.
EIA_API_KEY=
FRED_API_KEY=
ALPHAVANTAGE_API_KEY=
DUBAI_PULSE_CLIENT_ID=
DUBAI_PULSE_CLIENT_SECRET=
dubai_data_x-DDA-SecurityApplicationIdentifier=
dubai_data_client_id=
dubai_data_client_secret=

# ─── Forecast agent LLM (Anthropic-compatible endpoint by default) ─────
AGENT_LLM_API_KEY=
AGENT_LLM_MODEL=claude-sonnet-4-20250514
AGENT_LLM_BASE_URL=https://api.anthropic.com
AGENT_ENVIRONMENTS=dubai
AGENT_MODEL_ID=dxb-revenue
AGENT_FOCUS_YEAR=2027
AGENT_ACTUAL_YEAR=2025
AGENT_PROJECTION_YEARS=2026,2027,2028,2029,2030
# Mirrors future-advisor-forecast-agent/.env.example — Google News + GCC desks.
MARKET_NEWS_FEEDS=https://www.cnbc.com/id/20910258/device/rss/rss.html,https://feeds.content.dowjones.io/public/rss/socialeconomyfeed,https://feeds.bbci.co.uk/news/business/rss.xml,https://www.mediaoffice.abudhabi/en/economy/rss/,https://www.arabianbusiness.com/gcc/uae/feed

# ─── Forecast-py LLM (optional; blank → rule-based fallback) ───────────
LLM_PROVIDER=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ─── Live-agent (market data pullers) ──────────────────────────────────
SOURCES_ENABLED=yahoo,fred,te_uae,te_matrix
TE_USER_AGENT=FutureAdvisor/1.0 (ops@example.com)

# ─── Chatbot (LibreChat + synthea-agent + Neo4j) ───────────────────────
NEO4J_PASSWORD=CHANGE_ME_NEO4J_PASSWORD

# LibreChat crypto — JWT/CREDS_KEY/MEILI are 64 hex chars (openssl rand -hex 32),
# CREDS_IV is 32 hex chars (openssl rand -hex 16). install-full.sh rotates them.
LIBRECHAT_JWT_SECRET=CHANGE_ME_LIBRECHAT_JWT_SECRET
LIBRECHAT_JWT_REFRESH_SECRET=CHANGE_ME_LIBRECHAT_JWT_REFRESH_SECRET
CREDS_KEY=CHANGE_ME_CREDS_KEY
CREDS_IV=CHANGE_ME_CREDS_IV
MEILI_MASTER_KEY=CHANGE_ME_MEILI_MASTER_KEY

# synthea-agent LLM provider (ollama via host.docker.internal by default).
# For a managed-API only install, set CHAT_LLM_PROVIDER=anthropic and provide
# ANTHROPIC_API_KEY; the Ollama hook is then unused.
CHAT_LLM_PROVIDER=ollama
CHAT_LLM_MODEL=qwen3:4b-instruct-2507-q4_K_M
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M
CYPHER_MODEL=futureadvisor-cypher:latest
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# UX
ALLOW_REGISTRATION=true
ALLOW_EMAIL_LOGIN=true
LOG_LEVEL=INFO

dubai_data_base=https://apis.data.dubai
dubai_data_x-DDA-SecurityApplicationIdentifier=P-FwarrLYGqZE4Lcn4UFM7Rqr6WXxh88up
dubai_data_client_id=ee0e295d-ed32-423e-8c68-17e0c8182212
dubai_data_client_secret=e887dbb1-da94-4716-9404-82b468a50c2c
NEXT_PUBLIC_FA_SAMPLE_MODE=off
